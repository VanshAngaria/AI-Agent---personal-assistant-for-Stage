# Self-contained rules for submission/ (the root .gitignore also applies when the whole repo is pushed).

# Generated runtime state: `python -m oua run-all` recreates it
/viewer_state/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Simulator output: per-viewer synthetic events, ~12 MB, regenerated by `python -m oua simulate`
sample_run/sim/outcome_events.jsonl

# Our explainer PDFs are kept even if a parent rule ignores PDFs
!docs/pdf/
!docs/pdf/*.pdf

# Python caches, builds, environments
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Secrets and editors
.env
.env.*
.vscode/
.idea/
